# Leave NODE_ENV unset locally; set production in your deployment environment.
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./data/stacked-deck.db
# For Azure SQL, set DATABASE_PROVIDER=sqlserver and use your app’s managed identity.
# Local SQL connections use your Azure CLI login (az login).
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
# Set to the number of trusted reverse proxy hops in production (usually 1).
TRUST_PROXY=0
# Optional local demo: db:seed requires a password of at least 12 characters.
SEED_EMAIL=demo@stackeddeck.local
SEED_PASSWORD=
