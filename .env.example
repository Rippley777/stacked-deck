# Leave NODE_ENV unset locally; set production in your deployment environment.
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./data/stacked-deck.db
# For Azure SQL, set DATABASE_PROVIDER=sqlserver and use your app’s managed identity.
# Local SQL connections use your Azure CLI login (az login).
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
# Set to the number of trusted reverse proxy hops in production (usually 1).
TRUST_PROXY=0
# Optional local demo: db:seed requires a password of at least 12 characters.
SEED_EMAIL=demo@stackeddeck.local
SEED_PASSWORD=
# Optional AI photo identification (server only; never use a VITE_ prefix).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
# Optional independent valuation model; defaults to OPENAI_VISION_MODEL, then gpt-4.1-mini.
OPENAI_VALUATION_MODEL=

# House Edge browser analytics. Leave key/endpoint empty to disable.
# Use the browser ingestion key and exact collector URL (ending in /api/collect).
# These public values are embedded at build time; rebuild after changes.
VITE_HOUSE_EDGE_PROJECT=stacked-deck
VITE_HOUSE_EDGE_KEY=
VITE_HOUSE_EDGE_ENDPOINT=
# Opt in only when testing against a development analytics project.
VITE_HOUSE_EDGE_TRACK_DEVELOPMENT=false
# Also set VITE_HOUSE_EDGE_ENDPOINT on the production server for its CSP.
